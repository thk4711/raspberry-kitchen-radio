# Minimal SWUpdate 2025.05 configuration for the radio's local A/B updater.
# The existing authenticated radio web application is the only web entry point.
CONFIG_HAVE_DOT_CONFIG=y

CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
# CONFIG_SCRIPTS is not set
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/hwrevision"
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"

CONFIG_SOCKET_CTRL_PATH="/run/swupdate/sockinstctrl"
CONFIG_SOCKET_PROGRESS_PATH="/run/swupdate/swupdateprog"
CONFIG_SOCKET_REMOTE_HANDLER_DIRECTORY="/run/swupdate"

# CONFIG_FEATURE_SYSLOG is not set
# CONFIG_DEBUG is not set
# CONFIG_WERROR is not set
# CONFIG_NOCLEANUP is not set

# Environment changes from sw-description are committed through libubootenv.
# CONFIG_BOOTLOADER_NONE is not set
CONFIG_UBOOT=y
CONFIG_UBOOT_FWENV="/etc/fw_env.config"
CONFIG_UBOOT_DEFAULTENV="/etc/u-boot-initial-env"
CONFIG_BOOTLOADER_DEFAULT_UBOOT=y
# CONFIG_BOOTLOADER_STATIC_LINKED is not set
CONFIG_UPDATE_STATE_CHOICE_BOOTLOADER=y
CONFIG_UPDATE_STATE_BOOTLOADER="ustate"

# OpenSSL is present only for SHA-256 artifact verification. Firmware signing
# and encryption are deliberately outside the agreed threat model.
CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_HASH_VERIFY=y
# CONFIG_SIGNED_IMAGES is not set
# CONFIG_ENCRYPTED_IMAGES is not set

# zlib support makes CONFIG_GUNZIP available for streamed gzip payloads.
CONFIG_GUNZIP=y
# CONFIG_ZSTD is not set

CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
# CONFIG_LUAEXTERNAL is not set
# CONFIG_SETSWDESCRIPTION is not set

# Only the raw block image path and transactional boot environment are needed.
# CONFIG_ARCHIVE is not set
CONFIG_BOOTLOADERHANDLER=y
# CONFIG_COPY is not set
# CONFIG_DISKPART is not set
# CONFIG_DISKFORMAT_HANDLER is not set
# CONFIG_LUASCRIPTHANDLER is not set
# CONFIG_EMBEDDED_LUA_HANDLER is not set
# CONFIG_EMMC_HANDLER is not set
CONFIG_RAW=y
# CONFIG_RDIFFHANDLER is not set
# CONFIG_SHELLSCRIPTHANDLER is not set
# CONFIG_SWUFORWARDER_HANDLER is not set
# CONFIG_UBIVOL is not set
# CONFIG_UCFWHANDLER is not set
# CONFIG_UNIQUEUUID is not set

# No downloader, polling daemon, embedded web server, or remote handler.
# CONFIG_CURL is not set
# CONFIG_CURL_SSL is not set
# CONFIG_SURICATTA is not set
# CONFIG_WEBSERVER is not set
# CONFIG_MONGOOSE is not set
# CONFIG_MONGOOSEIPV6 is not set