#!/bin/sh
#
# S41wlan — bring up WiFi (wlan0) asynchronously.
#
# Optimized boot path:
#   1. start wpa_supplicant
#   2. wait briefly for WiFi association/carrier
#   3. apply last known DHCP lease immediately, if available
#   4. start udhcpc in the background, requesting the cached IP
#
# DHCP remains authoritative: /etc/udhcpc-wlan.script replaces the optimistic
# address if the DHCP server confirms a different lease and refreshes the cache.

IFACE=wlan0
WPA_CONF=/etc/wpa_supplicant.conf
WPA_PID=/run/wpa_supplicant.${IFACE}.pid
UDHCPC_PID=/run/udhcpc.${IFACE}.pid
UDHCPC_SCRIPT=/etc/udhcpc-wlan.script
CACHE=/var/lib/wlan-last-lease.env
WIFI_COUNTRY_FILE=/etc/radio/wifi-country
# Optional static-IP config written by provision-from-boot (from radio-config.txt
# ip_* keys) or by the web UI's privileged helper. When present, S41wlan applies
# this fixed address and skips DHCP. Absent -> DHCP (the default). Same
# IP/PREFIX/ROUTER/DNS shape as $CACHE so apply_cached_lease's logic is reused.
WLAN_STATIC_FILE=/etc/radio/wlan-static.env
# WiFi startup diagnostics are kept in RAM. The default log is deliberately
# /tmp (tmpfs), so it vanishes on reboot and cannot wear the SD card. Override
# S41WLAN_LOG=/dev/null to silence it or use another tmpfs path while debugging.
LOG="${S41WLAN_LOG:-/tmp/S41wlan.log}"
# The Pi 3A+ brcmfmac driver normally creates wlan0 within about 8-9 seconds,
# but cold boots need some margin. Poll frequently rather than sleeping for
# whole seconds; this bounds the wait at 12 seconds without adding a fixed delay.
IFACE_WAIT_SECONDS="${S41WLAN_IFACE_WAIT_SECONDS:-12}"
IFACE_POLL_SECONDS="${S41WLAN_IFACE_POLL_SECONDS:-0.25}"
LINK_WAIT_SECONDS="${S41WLAN_LINK_WAIT_SECONDS:-8}"

log() {
	echo "S41wlan: $*" >> "$LOG"
}

wait_for_iface() {
	log "waiting up to ${IFACE_WAIT_SECONDS}s for ${IFACE} (poll=${IFACE_POLL_SECONDS}s)"
	started=$(date +%s 2>/dev/null || echo 0)
	checks=0
	while [ "$checks" -lt $((IFACE_WAIT_SECONDS * 4)) ]; do
		if [ -d "/sys/class/net/${IFACE}" ]; then
			now=$(date +%s 2>/dev/null || echo "$started")
			log "${IFACE} appeared after $((now - started))s"
			return 0
		fi
		sleep "$IFACE_POLL_SECONDS"
		checks=$((checks + 1))
	done
	log "${IFACE} did not appear within ${IFACE_WAIT_SECONDS}s"
	return 1
}

wait_for_wifi_link() {
	# Wait up to about 8 seconds. This avoids burning the first DHCP DISCOVERs
	# before association is complete, but still keeps boot non-blocking because
	# start_wifi itself runs in the background from the init script.
	log "waiting up to ${LINK_WAIT_SECONDS}s for WiFi association"
	started=$(date +%s 2>/dev/null || echo 0)
	i=0
	while [ "$i" -lt $((LINK_WAIT_SECONDS * 4)) ]; do
		carrier="$(cat "/sys/class/net/${IFACE}/carrier" 2>/dev/null || echo 0)"
		state="$(cat "/sys/class/net/${IFACE}/operstate" 2>/dev/null || echo unknown)"
		if [ "$carrier" = "1" ] || [ "$state" = "up" ]; then
			now=$(date +%s 2>/dev/null || echo "$started")
			log "${IFACE} link ready after $((now - started))s: carrier=${carrier} operstate=${state}"
			return 0
		fi
		sleep "$IFACE_POLL_SECONDS"
		i=$((i + 1))
	done
	log "${IFACE} link not ready within ${LINK_WAIT_SECONDS}s; continuing with network setup anyway"
	return 1
}

valid_ipv4() {
	echo "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
}

# Apply the WiFi regulatory domain (country code) written by provision-from-boot
# to $WIFI_COUNTRY_FILE from the radio-config.txt "wifi_country=" key. Uses `iw`
# because this wpa_supplicant is built without CONFIG_CTRL_IFACE and rejects a
# country= line. No file (or no iw) means keep the wireless-regdb worldwide
# default. Non-fatal: a failure here never blocks WiFi bring-up.
apply_regdomain() {
	[ -f "$WIFI_COUNTRY_FILE" ] || return 0
	cc="$(cat "$WIFI_COUNTRY_FILE" 2>/dev/null | tr -d ' \r\n')"
	case "$cc" in
		[A-Za-z][A-Za-z]) ;;
		*) log "regdomain: invalid country '$cc' in $WIFI_COUNTRY_FILE; skipping"; return 0 ;;
	esac
	if ! command -v iw >/dev/null 2>&1; then
		log "regdomain: iw not available; cannot set country $cc"
		return 0
	fi
	if iw reg set "$cc" >> "$LOG" 2>&1; then
		log "regdomain: set to $cc"
	else
		log "regdomain: 'iw reg set $cc' failed"
	fi
}

apply_cached_lease() {
	[ -f "$CACHE" ] || {
		log "no cached DHCP lease at $CACHE"
		return 1
	}

	# shellcheck disable=SC1090 # BusyBox shell; file is generated by our DHCP script.
	. "$CACHE"
	if [ -z "${IP:-}" ] || ! valid_ipv4 "$IP"; then
		log "cached lease missing valid IP"
		return 1
	fi
	[ -n "${PREFIX:-}" ] || PREFIX=24

	log "applying cached DHCP lease: ${IP}/${PREFIX} router=${ROUTER:-} dns=${DNS:-}"
	ip -4 addr flush dev "$IFACE" scope global >> "$LOG" 2>&1 || true
	if [ -n "${BROADCAST:-}" ]; then
		ip addr add "${IP}/${PREFIX}" broadcast "$BROADCAST" dev "$IFACE" >> "$LOG" 2>&1 || return 1
	else
		ip addr add "${IP}/${PREFIX}" dev "$IFACE" >> "$LOG" 2>&1 || return 1
	fi

	ip route del default dev "$IFACE" >> "$LOG" 2>&1 || true
	if [ -n "${ROUTER:-}" ]; then
		for r in $ROUTER; do
			ip route add default via "$r" dev "$IFACE" >> "$LOG" 2>&1 || true
			break
		done
	fi

	if [ -n "${DNS:-}" ]; then
		: > /etc/resolv.conf
		[ -n "${DOMAIN:-}" ] && echo "search $DOMAIN # $IFACE" >> /etc/resolv.conf
		for d in $DNS; do
			echo "nameserver $d # $IFACE" >> /etc/resolv.conf
		done
	fi
	return 0
}

cached_ip_arg() {
	[ -f "$CACHE" ] || return 1
	# shellcheck disable=SC1090
	. "$CACHE"
	[ -n "${IP:-}" ] && valid_ipv4 "$IP" || return 1
	printf '%s\n' "$IP"
}

# Apply a fixed static address from $WLAN_STATIC_FILE (if present). Mirrors
# apply_cached_lease but sourced from the provisioned/web-UI file. Returns 0 when
# a static address was applied (so start_wifi can skip DHCP), 1 otherwise.
apply_static_config() {
	[ -f "$WLAN_STATIC_FILE" ] || return 1
	# shellcheck disable=SC1090 # BusyBox shell; file is generated by us.
	. "$WLAN_STATIC_FILE"
	if [ -z "${IP:-}" ] || ! valid_ipv4 "$IP"; then
		log "static config missing valid IP; falling back to DHCP"
		return 1
	fi
	[ -n "${PREFIX:-}" ] || PREFIX=24

	log "applying static config: ${IP}/${PREFIX} router=${ROUTER:-} dns=${DNS:-}"
	ip -4 addr flush dev "$IFACE" scope global >> "$LOG" 2>&1 || true
	ip addr add "${IP}/${PREFIX}" dev "$IFACE" >> "$LOG" 2>&1 || return 1

	ip route del default dev "$IFACE" >> "$LOG" 2>&1 || true
	if [ -n "${ROUTER:-}" ]; then
		for r in $ROUTER; do
			ip route add default via "$r" dev "$IFACE" >> "$LOG" 2>&1 || true
			break
		done
	fi

	if [ -n "${DNS:-}" ]; then
		: > /etc/resolv.conf
		for d in $DNS; do
			echo "nameserver $d # $IFACE" >> /etc/resolv.conf
		done
	fi
	return 0
}

start_dhcp() {
	req_ip="$(cached_ip_arg 2>/dev/null || true)"
	# Send DHCP option 12 so routers/DHCP servers identify this client by the
	# same live hostname used by Avahi, AirPlay, Spotify and Bluetooth.
	dhcp_hostname="$(hostname)"
	args="-i $IFACE -b -q -p $UDHCPC_PID -s $UDHCPC_SCRIPT -a"
	if [ -n "$req_ip" ]; then
		log "starting DHCP client in background, asking for cached IP $req_ip (hostname=${dhcp_hostname})"
		# shellcheck disable=SC2086 # args is an intentional BusyBox argv list.
		udhcpc $args -x "hostname:$dhcp_hostname" -r "$req_ip" >> "$LOG" 2>&1 &
	else
		log "starting DHCP client in background (hostname=${dhcp_hostname})"
		# shellcheck disable=SC2086 # args is an intentional BusyBox argv list.
		udhcpc $args -x "hostname:$dhcp_hostname" >> "$LOG" 2>&1 &
	fi
}

start_wifi() {
	: > "$LOG"
	log "starting WiFi on ${IFACE}; config=${WPA_CONF}"

	if [ ! -f "$WPA_CONF" ]; then
		log "configuration error: missing $WPA_CONF"
		return 1
	fi

	if grep -q '^[[:space:]]*\(ctrl_interface\|update_config\|country\)=' "$WPA_CONF"; then
		log "configuration error: $WPA_CONF contains unsupported global fields"
		return 1
	fi

	if ! grep -q '^[[:space:]]*key_mgmt=WPA-PSK[[:space:]]*$' "$WPA_CONF"; then
		log "configuration error: $WPA_CONF is missing key_mgmt=WPA-PSK"
		return 1
	fi

	if ! wait_for_iface; then
		log "${IFACE} did not appear"
		dmesg | grep -Ei 'brcmfmac|firmware|wlan|mmc|sdio' >> "$LOG" 2>&1 || true
		return 1
	fi

	ip link set "$IFACE" up >> "$LOG" 2>&1 || true

	# Set the regulatory domain before association so the allowed channels/power
	# are correct while wpa_supplicant scans and associates.
	apply_regdomain

	killall wpa_supplicant >> "$LOG" 2>&1 || true

	log "starting wpa_supplicant with driver nl80211"
	wpa_supplicant -B -P "$WPA_PID" -i "$IFACE" -c "$WPA_CONF" -D nl80211 >> "$LOG" 2>&1 || {
		log "wpa_supplicant failed to start"
		return 1
	}

	wait_for_wifi_link || true
	# A provisioned/web-UI static address wins over DHCP. When applied, we do
	# not start udhcpc at all so the fixed address is authoritative.
	if apply_static_config; then
		log "static IP applied; skipping DHCP"
		return 0
	fi
	apply_cached_lease || log "no usable cached lease; DHCP will obtain a fresh address"
	start_dhcp
	return 0
}

stop_wifi() {
	log "stopping ${IFACE}"
	[ -f "$UDHCPC_PID" ] && kill "$(cat "$UDHCPC_PID")" >> "$LOG" 2>&1 || true
	[ -f "$WPA_PID" ] && kill "$(cat "$WPA_PID")" >> "$LOG" 2>&1 || true
	killall udhcpc >> "$LOG" 2>&1 || true
	killall wpa_supplicant >> "$LOG" 2>&1 || true
	ip -4 addr flush dev "$IFACE" scope global >> "$LOG" 2>&1 || true
	ip link set "$IFACE" down >> "$LOG" 2>&1 || true
}

case "$1" in
	start)
		start_wifi &
		echo "Starting WiFi: OK"
		;;
	stop)
		stop_wifi
		echo "Stopping WiFi: OK"
		;;
	restart|reload)
		stop_wifi
		start_wifi &
		echo "Restarting WiFi: OK"
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
