#!/bin/sh
set -eu

GADGET_NAME=radio-usb-audio
GADGET_ROOT=/sys/kernel/config/usb_gadget
GADGET="$GADGET_ROOT/$GADGET_NAME"
CONFIG=c.1
MODE_FILE=/etc/radio/usb_audio.ini
HID_FUNCTION=hid.usb0
# Consumer-control HID report descriptor: one input byte carrying a bitmap of
# Play/Pause (bit0), Scan Next (bit1), Scan Previous (bit2) and Stop (bit3)
# usages from the Consumer Page (0x0C). This lets the appliance send the host a
# media Play/Pause key; the radio-usb-audio-hid helper writes the report bytes.
HID_REPORT_DESC='\x05\x0c\x09\x01\xa1\x01\x15\x00\x25\x01\x75\x01\x95\x04\x09\xcd\x09\xb5\x09\xb6\x09\xb7\x81\x02\x95\x04\x81\x01\xc0'

write_value() {
	printf '%s' "$2" > "$1"
}

serial_number() {
	if [ -r /sys/firmware/devicetree/base/serial-number ]; then
		tr -d '\000' < /sys/firmware/devicetree/base/serial-number
	else
		awk -F: '/^Serial/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' /proc/cpuinfo
	fi
}

stop_gadget() {
	[ -d "$GADGET" ] || return 0
	[ ! -e "$GADGET/UDC" ] || write_value "$GADGET/UDC" ""
	for function in "$GADGET"/configs/$CONFIG/uac*.usb0; do
		[ -e "$function" ] || continue
		rm -f "$function"
	done
	rm -f "$GADGET/configs/$CONFIG/$HID_FUNCTION"
	rmdir "$GADGET/configs/$CONFIG/strings/0x409" 2>/dev/null || true
	rmdir "$GADGET/configs/$CONFIG" 2>/dev/null || true
	for function in "$GADGET"/functions/uac*.usb0; do
		[ -d "$function" ] || continue
		rmdir "$function" 2>/dev/null || true
	done
	rmdir "$GADGET/functions/$HID_FUNCTION" 2>/dev/null || true
	rmdir "$GADGET/strings/0x409" 2>/dev/null || true
	rmdir "$GADGET" 2>/dev/null || true
}

start_gadget() {
	mode=uac1
	if [ -r "$MODE_FILE" ]; then
		configured_mode=$(sed -n 's/^mode[[:space:]]*=[[:space:]]*\(uac[12]\)[[:space:]]*$/\1/p' "$MODE_FILE" | head -n 1)
		[ -z "$configured_mode" ] || mode=$configured_mode
	fi
	if [ "$mode" = uac2 ]; then
		FUNCTION=uac2.usb0
		DRIVER=usb_f_uac2
	else
		FUNCTION=uac1.usb0
		DRIVER=usb_f_uac1
	fi
	modprobe dwc2
	modprobe libcomposite
	modprobe "$DRIVER"
	# HID function driver for the composite media-key interface. Best-effort:
	# an image without usb_f_hid still brings up audio (the HID block below is
	# guarded), so a missing module never breaks the USB Audio source.
	modprobe usb_f_hid 2>/dev/null || true
	mkdir -p /sys/kernel/config
	if ! grep -qs ' /sys/kernel/config configfs ' /proc/mounts; then
		mount -t configfs configfs /sys/kernel/config
	fi

	stop_gadget
	mkdir -p "$GADGET"
	write_value "$GADGET/idVendor" 0x1d6b
	write_value "$GADGET/idProduct" 0x0101
	write_value "$GADGET/bcdDevice" 0x0100
	write_value "$GADGET/bcdUSB" 0x0200

	mkdir -p "$GADGET/strings/0x409"
	write_value "$GADGET/strings/0x409/serialnumber" "$(serial_number)"
	write_value "$GADGET/strings/0x409/manufacturer" "Raspberry Pi"
	write_value "$GADGET/strings/0x409/product" "PiSonic USB Audio"

	mkdir -p "$GADGET/configs/$CONFIG/strings/0x409"
	write_value "$GADGET/configs/$CONFIG/MaxPower" 2
	mode_label=$(printf '%s' "$mode" | tr '[:lower:]' '[:upper:]')
	write_value "$GADGET/configs/$CONFIG/strings/0x409/configuration" \
		"$mode_label stereo playback"

	mkdir -p "$GADGET/functions/$FUNCTION"
	write_value "$GADGET/functions/$FUNCTION/c_chmask" 3
	write_value "$GADGET/functions/$FUNCTION/p_chmask" 0
	if [ "$mode" = uac2 ]; then
		# UAC2 validates both clock sources even though playback is disabled.
		write_value "$GADGET/functions/$FUNCTION/p_srate" 48000
		write_value "$GADGET/functions/$FUNCTION/p_ssize" 2
		write_value "$GADGET/functions/$FUNCTION/c_srate" "44100,48000,96000"
		write_value "$GADGET/functions/$FUNCTION/c_ssize" 3
		write_value "$GADGET/functions/$FUNCTION/c_sync" adaptive
	else
		write_value "$GADGET/functions/$FUNCTION/c_srate" 48000
		write_value "$GADGET/functions/$FUNCTION/c_ssize" 2
	fi
	write_value "$GADGET/functions/$FUNCTION/c_mute_present" 0
	write_value "$GADGET/functions/$FUNCTION/c_volume_present" 0
	write_value "$GADGET/functions/$FUNCTION/p_mute_present" 0
	write_value "$GADGET/functions/$FUNCTION/p_volume_present" 0
	ln -s "$GADGET/functions/$FUNCTION" "$GADGET/configs/$CONFIG/$FUNCTION"

	# Composite HID consumer-control function (media keys). Guarded so audio is
	# unaffected if usb_f_hid is unavailable: without it, /dev/hidgN is simply
	# not created and radio-usb-audio-hid becomes a no-op, leaving the inhibit
	# marker as the source-switch fallback.
	if mkdir -p "$GADGET/functions/$HID_FUNCTION" 2>/dev/null; then
		write_value "$GADGET/functions/$HID_FUNCTION/protocol" 0
		write_value "$GADGET/functions/$HID_FUNCTION/subclass" 0
		write_value "$GADGET/functions/$HID_FUNCTION/report_length" 1
		# The report descriptor contains raw bytes, so use printf's escape
		# handling rather than the plain-string write_value helper.
		printf '%b' "$HID_REPORT_DESC" > "$GADGET/functions/$HID_FUNCTION/report_desc"
		ln -s "$GADGET/functions/$HID_FUNCTION" "$GADGET/configs/$CONFIG/$HID_FUNCTION"
	else
		echo "usb_f_hid unavailable; media-key HID function not created" >&2
	fi

	udc=""
	tries=0
	while [ "$tries" -lt 100 ]; do
		for path in /sys/class/udc/*; do
			[ -e "$path" ] || continue
			udc=${path##*/}
			break
		done
		[ -z "$udc" ] || break
		tries=$((tries + 1))
		sleep 0.1
	done
	if [ -z "$udc" ]; then
		echo "No USB Device Controller found; is DWC2 in peripheral mode?" >&2
		stop_gadget
		exit 1
	fi
	write_value "$GADGET/UDC" "$udc"
	echo "Bound USB Audio gadget to $udc"
}

case "${1:-}" in
	start) start_gadget ;;
	stop) stop_gadget ;;
	restart) stop_gadget; start_gadget ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac